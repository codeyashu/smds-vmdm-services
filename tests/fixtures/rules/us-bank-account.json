{"iso2CountryCode":"US","rules":[{"fieldName":"bankAccountControlKeyNumber","displayLabel":"Control Key","fieldGroupLabel":"Bank Accounts","isRequired":false,"isApplicable":true,"regexPattern":"^CD$|^TX$|^PD$|^82$","errorMessage":"Control Key must be exactly 2 characters long and contain only the values CD, TX, PD, or 82."},{"fieldName":"bankingInstitutionCode","displayLabel":"Bank Key","fieldGroupLabel":"Bank Accounts","isRequired":false,"isApplicable":true,"regexPattern":"^[0-9]{9}$","errorMessage":"Bank Key must be exactly 9 digits, containing only numbers 0-9."},{"fieldName":"houseBankCode","displayLabel":"House Bank","fieldGroupLabel":"Bank Accounts","isRequired":false,"isApplicable":true,"regexPattern":"^[A-Z0-9]{5}$","errorMessage":"House Bank must be exactly 5 characters, containing only uppercase letters and numbers."},{"fieldName":"ibanNumber","displayLabel":"IBAN","fieldGroupLabel":"Bank Accounts","isRequired":false,"isApplicable":false,"errorMessage":"IBAN is not applicable for US country."},{"fieldName":"isrNumber","displayLabel":"PBC/POR number or ISR number","fieldGroupLabel":"Bank Accounts","isRequired":false,"isApplicable":true},{"fieldName":"bankAccountNumber","displayLabel":"Bank Account Number","fieldGroupLabel":"Bank Accounts","relatedFields":["isoCurrencyCode"],"isRequired":false,"isApplicable":true,"errorMessage":"Bank Account Number is mandatory.","dependencies":[{"ruleType":"conditional","conditions":[{"fieldName":"bankAccountNumber","operator":"exists","action":{"targetFields":["isoCurrencyCode"],"actionType":"makeRequired"}}],"errorMessage":"Currency is mandatory when a Bank Account Number is provided."}]},{"fieldName":"hasCollectionAuthentication","displayLabel":"Has Collection Authentication","fieldGroupLabel":"Bank Accounts","isRequired":false,"isApplicable":true},{"fieldName":"isoCurrencyCode","displayLabel":"Bank Currency","fieldGroupLabel":"Bank Accounts","scopeKey":"vendor.bankAccounts","isRequired":false,"isApplicable":true,"regexP