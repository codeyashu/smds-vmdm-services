# Copy to `.env` in this repo. Bearer token must match portal `AI_SERVICE_BEARER_TOKEN`.

# --- Auth (portal BFF presents this on extract routes) ---
DOCAI_SERVICE_BEARER_TOKEN=dev-token

# --- Azure Document Intelligence (OCR / layout) ---
DOCAI_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
DOCAI_DI_KEY=
DOCAI_DI_MODEL=prebuilt-layout

# --- Azure OpenAI (classify + extract; vision-capable deployment required) ---
DOCAI_AOAI_ENDPOINT=https://<resource>.openai.azure.com
DOCAI_AOAI_KEY=
DOCAI_AOAI_DEPLOYMENT=gpt-4o
# DOCAI_AOAI_API_VERSION=2024-08-01-preview

# --- Provider overrides (default: auto = Azure when creds above are set) ---
# DOCAI_OCR_PROVIDER=auto|azure_di|pymupdf|tesseract
# DOCAI_LLM_PROVIDER=auto|azure|openai|gemini|groq|ollama|none

# --- Free/local alternatives (explicit opt-in only) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2-vision
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# --- Limits ---
DOCAI_MAX_FILE_BYTES=10485760
DOCAI_MAX_PAGES=20
DOCAI_MAX_BATCH_FILES=5
DOCAI_LLM_TIMEOUT_S=30

# --- Document requirements SQLite store ---
DOCAI_DB_PATH=./data/docai.db
