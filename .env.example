# Copy to `.env` in this repo. Bearer token must match portal `AI_SERVICE_BEARER_TOKEN`.

# --- Auth (portal BFF presents this on extract routes) ---
DOCAI_SERVICE_BEARER_TOKEN=dev-token

# --- Azure Document Intelligence (OCR / layout) ---
DOCAI_DI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
DOCAI_DI_KEY=
DOCAI_DI_MODEL=prebuilt-layout

# --- Azure OpenAI (classify + extract; vision-capable deployment required) ---
DOCAI_AOAI_ENDPOINT=https://<resource>.openai.azure.com
DOCAI_AOAI_KEY=
DOCAI_AOAI_DEPLOYMENT=gpt-4o
# DOCAI_AOAI_API_VERSION=2024-08-01-preview

# --- Provider overrides (default: auto = Azure when creds above are set) ---
# DOCAI_OCR_PROVIDER=auto|azure_di|pymupdf|tesseract
# DOCAI_LLM_PROVIDER=auto|azure|openai|gemini|groq|ollama|none

# --- Free/local alternatives (explicit opt-in only) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2-vision
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=

# --- Limits ---
DOCAI_MAX_FILE_BYTES=10485760
DOCAI_MAX_PAGES=20
DOCAI_MAX_BATCH_FILES=5
DOCAI_LLM_TIMEOUT_S=30

# --- Langfuse (optional LLM observability) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=https://cloud.langfuse.com  # alias for LANGFUSE_BASE_URL
# LLM cost estimates (Langfuse + observability dashboard)
# Azure retail API Sweden Central regional GPT-4.1: $2.42 / $9.68 per 1M (input/output)
# Global Standard GPT-4.1: $2.00 / $8.00 per 1M — use those if your deployment is Global
LLM_COST_INPUT_PER_MTOK=2.42
LLM_COST_OUTPUT_PER_MTOK=9.68

# --- Web trust steward feedback (learning loop) ---
# WEB_TRUST_FEEDBACK_DIR=data/web-trust-feedback

# --- Document bundle LLM consistency (experimental; runs after adjudicate on ambiguous bundles) ---
# DOCUMENT_CORROBORATION_ENABLED=true

# --- UK Companies House live registry (GB web-trust connector) ---
# COMPANIES_HOUSE_API_KEY=

# --- India GSTIN live registry via GSP (IN web-trust connector) ---
# IN_GST_GSP_API_KEY=fixture
# IN_GST_GSP_BASE_URL=https://gsp.example.com
# IN_GST_GSP_LOOKUP_PATH=/gstin/{gstin}
# IN_GST_GSP_CLIENT_ID=
# IN_GST_LOOKUP_TIMEOUT_S=10

# --- Portal BFF fallback (only when MDM_* not set on services) ---
# VMDM_PORTAL_BFF_URL=http://localhost:3000

# --- MDM OAuth (services direct — copy from portal .env.local) ---
# MDM_OAUTH_TOKEN_URL=
# MDM_OAUTH_CLIENT_ID=
# MDM_OAUTH_CLIENT_SECRET=
# MDM_VENDOR_SEARCH_BASE_URL=
# MDM_VENDOR_REFERENCE_BASE_URL=
# MDM_COMPANY_SEARCH_BASE_URL=
# MDM_EXTERNAL_SERVICE_BASE_URL=
# MDM_ACCESS_POLICY_BASE_URL=https://api-cdt.maersk.com/customer-identity/access-policy
# MDM_ACCESS_POLICY_CLIENT_ID=usrSettings
# MDM_ACCESS_POLICY_OAUTH_CLIENT_ID=
# MDM_ACCESS_POLICY_OAUTH_CLIENT_SECRET=
# MDM_ACCESS_POLICY_CONSUMER_KEY=

# --- Optional Pydantic AI (falls back to deterministic stubs when false) ---
# DOCAI_ONBOARD_CHAT_LLM=false
# DOCAI_STEWARD_ASSIST_LLM=false

# --- Document requirements SQLite store ---
DOCAI_DB_PATH=./data/docai.db
